# Public (browser-safe) — Supabase project + anon key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Where the Cloudflare Worker API is reachable from the browser
NEXT_PUBLIC_WORKER_URL=http://127.0.0.1:8787

# Public URL of this dashboard, used for magic-link redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Stripe Checkout (stub until real keys are added)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PRICE_ID=
